   "hold": 3.5,
   "ok": true,
   "lines": 1
  },
  {
   "id": "s2-woke",
   "section": "s2",
   "start": 111.458,
   "text": "I woke up at five thirty, prayed, and put on my school uniform.",
   "words": 13,
   "hold_min": 5.1,
   "hold": 5.25,
   "ok": true,
   "lines": 1
  },
  {
   "id": "s2-knock",
